# ──────────────────────────────────────────────────────────────
# DATABASE
# Opción 1 — Supabase (producción / staging)
#   DATABASE_URL : Transaction pooler (puerto 6543) — runtime
#   DIRECT_URL   : Session pooler   (puerto 5432) — migraciones
#   Obtener en: Supabase Dashboard → Connect → Connection string
#   ⚠️  pgbouncer=true es obligatorio en DATABASE_URL con Supabase
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Opción 2 — Docker local (desarrollo)
# DATABASE_URL="postgresql://propadmin:propadmin123@localhost:5432/propadmin_db"
# DIRECT_URL="postgresql://propadmin:propadmin123@localhost:5432/propadmin_db"

# ──────────────────────────────────────────────────────────────
# JWT AUTH
# Generar con: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_min_32chars
JWT_REFRESH_SECRET=change_me_refresh_secret_key_min_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# FRONTEND
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ──────────────────────────────────────────────────────────────
# EMAIL — Resend (https://resend.com)
# API key en: Resend Dashboard → API Keys
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="PropAdmin <onboarding@resend.dev>"

# ──────────────────────────────────────────────────────────────
# UPLOADS / FINANCIERO
# ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
DEFAULT_INTEREST_RATE=0.03
